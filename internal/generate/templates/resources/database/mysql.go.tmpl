package database

import (
	"database/sql"
	"fmt"
	"log"
	"os"

)

func OpenDB() (*sql.DB, error) {
	
	dsn := fmt.Sprintf("%s:%s@tcp(%s:%s)/%s?multiStatements=true&parseTime=true", user, pass, host, port, dbName)
    
	db, err := sql.Open("mysql", dsn)
	if err != nil {
		return nil, fmt.Errorf("échec ouverture DB : %w", err)
	}
	if err := db.Ping(); err != nil {
		return nil, fmt.Errorf("échec ping DB : %w", err)
	}

	return db, nil
}



func Close(db *sql.DB) {
	if err := db.Close(); err != nil {
		log.Printf("⚠️ Erreur lors de la fermeture de la DB : %v", err)
	} else {
		log.Println("🧹 Base de données fermée proprement")
	}
}
